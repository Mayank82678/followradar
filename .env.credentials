# Firebase Credentials
# Get these from: https://console.firebase.google.com
# Settings → Your Apps → Web App → Config

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Razorpay Credentials
# Get these from: https://dashboard.razorpay.com
# Settings → API Keys → Copy Key ID and Secret

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id_here
NEXT_RAZORPAY_KEY_SECRET=your_secret_key_here

# Database (Optional - for future backend)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/followradar

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NODE_ENV=production
